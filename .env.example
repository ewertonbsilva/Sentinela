# Sentinela: configuracao. O instalador copia este arquivo para /opt/sentinela/.env (chmod 640) e gera os segredos.
# Todos os valores abaixo sao ficticios (faixas 192.0.2.0/24, 198.51.100.0/24 e exemplo.com sao reservadas para documentacao).

# ---- Aparencia
# Nome da sua organizacao no titulo e na tela de login. Vazio = so "Sentinela".
ORG_NOME=
# Fuso horario de exibicao (nome IANA). Todas as datas da tela e dos CSV usam este fuso.
PAINEL_TZ=America/Sao_Paulo

# ---- Rede do painel
# Escuta so neste IP. 127.0.0.1 serve se o proxy reverso roda no mesmo host (fora do Docker).
# Se o proxy e um container Docker, use o IP do docker0 (normalmente 172.17.0.1): o container alcanca, a rede local nao.
PAINEL_BIND=127.0.0.1
PAINEL_PORT=8088
# Subcaminho em que o proxy publica o painel (vazio = raiz). Funciona com ou sem remocao do prefixo pelo proxy.
PAINEL_BASE=/sentinela
PAINEL_SECRET=gerado-pelo-instalador
# 1 = cookie so por HTTPS (o correto em producao). Use 0 apenas para testar em http://127.0.0.1.
COOKIE_SECURE=1
IDLE_SECONDS=900
MAX_LIFE_SECONDS=28800
# Redes de onde o proxy reverso chega ao painel (so dele se aceita o cabecalho X-Forwarded-For).
TRUSTED_PROXIES=172.16.0.0/12

# ---- LAPI do CrowdSec (a maquina "sentinela" e criada pelo instalador)
LAPI_URL=http://127.0.0.1:8080
LAPI_MACHINE=sentinela
LAPI_PASSWORD=gerado-pelo-instalador
# Chave de bouncer (criada pelo instalador): permite consultar decisoes por IP, inclusive as da lista da comunidade
BOUNCER_KEY=
# Metricas do motor (Prometheus, so local) e configuracao do CrowdSec (leitura)
PROM_URL=http://127.0.0.1:6060/metrics
CROWDSEC_CONFIG_DIR=/etc/crowdsec

# ---- Autenticacao (LDAP por LDAPS). OBRIGATORIO: sem isto o servico nao inicia.
# O painel faz um "bind" com o usuario e a senha digitados; nenhuma senha e guardada.
LDAP_HOST=ldap.exemplo.com
LDAP_PORT=636
LDAP_BASE=ou=people,dc=exemplo,dc=com
# Molde do DN do usuario. {usuario} = login digitado, {base} = LDAP_BASE. Ex. para Active Directory: {usuario}@exemplo.com
LDAP_USER_DN=uid={usuario},{base}
# Certificado (CA) do servidor LDAP, fixado na conexao. Veja o README ("Obter o certificado do LDAP").
LDAP_CA=/opt/sentinela/ldap-ca.crt
# Nome DNS que consta no certificado (o ldap3 nao confere endereco IP no SAN).
LDAP_NAME=ldap.exemplo.com
# Dois servidores (opcional): o painel tenta primeiro o cuja rede contem o IP de quem entra, e o outro de reserva.
# Se usar, tire o # e eles passam a valer no lugar das LDAP_* acima.
#BROKER_A_NOME=Site-A
#BROKER_A_HOST=ldap-a.exemplo.com
#BROKER_A_PORT=636
#BROKER_A_CA=/opt/sentinela/ldap-a.crt
#BROKER_A_NAME=ldap-a.exemplo.com
#BROKER_A_REDES=192.0.2.0/24
#BROKER_B_NOME=Site-B
#BROKER_B_HOST=ldap-b.exemplo.com
#BROKER_B_PORT=636
#BROKER_B_CA=/opt/sentinela/ldap-b.crt
#BROKER_B_NAME=ldap-b.exemplo.com
#BROKER_B_REDES=198.51.100.0/24

# "Lembrar de mim" na tela de login: cookie persistente por REMEMBER_DAYS dias, tolerando REMEMBER_IDLE_SECONDS de
# inatividade (renovada a cada acao do usuario). REMEMBER_DAYS=0 tira a opcao da tela.
REMEMBER_DAYS=7
REMEMBER_IDLE_SECONDS=86400

# ---- Quem entra
# Quem pode ver o painel: todo usuario com este grupo no atributo memberOf (DN completo do grupo).
ALLOWED_GROUP=cn=sentinela,ou=groups,dc=exemplo,dc=com
# Opcional: logins avulsos (separados por virgula) que entram mesmo fora do grupo. Vazio = so o grupo.
# Sem ALLOWED_GROUP e sem ALLOWED_USERS ninguem entra.
ALLOWED_USERS=
# Restricao por IP (opcional, separados por virgula; IPs ou redes). Vazio = qualquer IP que chegue pelo proxy.
# Ex.: ALLOWED_IPS=192.0.2.45,198.51.100.0/24   (o IP e o do cliente real, como o proxy enxerga)
ALLOWED_IPS=

# ---- Liberar IP bloqueado (a unica acao de escrita do painel)
# Esses logins tambem passam a poder entrar no painel. So liga depois de definir a senha:
#   sudo ./deploy/senha-liberacao.sh   (grava o hash em UNBAN_HASH)
UNBAN_USERS=
UNBAN_HASH=
